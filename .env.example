# ==============================================================================
# AI / LLM Configuration (Groq API + Awesome Free LLM APIs)
# ==============================================================================
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_FALLBACK_MODEL=qwen/qwen3.8-27b
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
GROQ_MAX_TRANSCRIPT_CHARS=4000
GROQ_METADATA_DELAY_SECONDS=1

# Free LLM API Providers (from https://github.com/mnfst/awesome-free-llm-apis)
# Default: OVHcloud AI Endpoints (Permanent free anonymous tier, no key required!)
FREE_LLM_BASE_URL=https://oai.endpoints.kepler.ai.cloud.ovh.net/v1
FREE_LLM_API_KEY=
FREE_LLM_MODEL=Meta-Llama-3_3-70B-Instruct
# Other supported providers:
# OpenRouter:  FREE_LLM_BASE_URL=https://openrouter.ai/api/v1 | FREE_LLM_MODEL=openrouter/free
# Gemini:      FREE_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/ | FREE_LLM_MODEL=gemini-2.5-flash
# Mistral AI:  FREE_LLM_BASE_URL=https://api.mistral.ai/v1 | FREE_LLM_MODEL=mistral-small-latest

# ==============================================================================
# YouTube Publishing (Google OAuth v3)
# ==============================================================================
YOUTUBE_CLIENT_SECRETS_FILE=client_secret.json
YOUTUBE_TOKEN_FILE=youtube_token.json
YOUTUBE_PRIVACY_STATUS=public
UPLOAD_YOUTUBE=true
YOUTUBE_DESCRIPTION_TARGET_CHARS=4200

# Optional yt-dlp cookie export if needed
YTDLP_COOKIES_FROM_BROWSER=
YTDLP_BROWSER_PROFILE=
YTDLP_COOKIE_FILE=

# ==============================================================================
# Instagram Graph API (Professional / Creator Account)
# ==============================================================================
INSTAGRAM_ACCESS_TOKEN=your_instagram_graph_api_access_token_here
INSTAGRAM_GRAPH_API_VERSION=v26.0
INSTAGRAM_CAPTION_TARGET_CHARS=2000
INSTAGRAM_CAPTION_MENTIONS=
INSTAGRAM_HASHTAGS_FILE=instagram_hashtags.txt
INSTAGRAM_CAPTION_ROTATION_FILE=instagram_captions.txt
UPLOAD_INSTAGRAM=true

# ==============================================================================
# Facebook Reels API (Meta Graph API)
# ==============================================================================
FACEBOOK_PAGE_ID=your_facebook_page_id_here
FACEBOOK_ACCESS_TOKEN=your_facebook_page_access_token_here
FACEBOOK_GRAPH_API_VERSION=v26.0
UPLOAD_FACEBOOK=true
FACEBOOK_LIMIT_COOLDOWN_HOURS=24

# ==============================================================================
# Local File Queue & Engine Configuration
# ==============================================================================
CHANNEL_CONFIG_FILE=channels.toml
LINKS_FILE=links.txt
DOWNLOADED_LINKS_LOG=work/downloaded-links.log
LINKS_POLL_SECONDS=30
CREDENTIAL_CHECK_MINUTES=60
PENDING_RETRY_JOBS_PER_CYCLE=3

# Video Rendering & Layout Options
CLIP_DURATION_SECONDS=60
SHORTS_SELECTION_MODE=ai_highlights
MAX_SHORTS_PER_VIDEO=3
VIDEO_LAYOUT=split_gameplay
ENABLE_GAMEPLAY=true
GAMEPLAY_DIR=assets/gameplay
GAMEPLAY_ROTATION=gta5,minecraft,subway_surfers

# Caption Styling
ENABLE_CAPTIONS=true
CAPTION_FONT=Arial
CAPTION_FONT_SIZE=64
CAPTION_HIGHLIGHT_COLORS=&H0066FF00&,&H0000E6FF&,&H00FFFF00&

# FFmpeg Encoding Preset
VIDEO_CRF=22
VIDEO_PRESET=veryfast
VIDEO_ALLOW_UPSCALE=false

# Auto-Purge & Storage (zero accumulation)
ARCHIVE_ON_UPLOAD_LIMIT=false
ARCHIVE_DIR=work/pending_uploads
OPEN_UPLOAD_LIMIT_FOLDER=false
WORK_DIR=work
DATABASE_PATH=work/jobs.db
KEEP_WORK_FILES=false
DELETE_UPLOADED_CLIPS=true

# Remote AI Enhancer (Optional)
VIDEO_ENHANCER=none
APIMARKET_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

RIGHTS_ACKNOWLEDGED=true

